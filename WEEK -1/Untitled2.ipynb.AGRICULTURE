      ],
      "source": [
        "crop_data={\n",
        "\"crop_name\":\"Rice\",\n",
        "\"scientific_name\":\"Oryza sativa\",\n",
        "\"crop_type\":\"Cereal\",\n",
        "\"season\": \"kharif\",\n",
        "\"temparature\":25,\n",
        "\"annual_rainfall\":1200,\n",
        "\"soil_type\":\"clayey loam\",\n",
        "\"ideal_soil_ph\":2.5,\n",
        "\"growing_duration_time\":120,\n",
        "\"water_requirements\":\"high\",\n",
        "\"avg_yield_per_hectare_kg\":4000,\n",
        "\"primary_nutrients\": [\"Nitrogen\", \"phosphorous\", \"potassium\"],\n",
        "\"common_pests\": [\"stem boror\", \"brown planthopper\"],\n",
        "\"harvesting_method\":\"manual/mechanical\",\n",
        " \"storage_humidity_percent\":13\n",
        "}\n",
        "print(crop_data)\n",
        "crop_data[\"Area\"]=\"myhh heart\"\n",
        "crop_data[\"Pesticide\"]=\"sharonuuu\"\n",
        "print(crop_data)\n",
        "\n",
        "\n"
      ]
    },
    {
